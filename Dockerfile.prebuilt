# =========================================================
# Ultra-Fast Multi-Arch Dockerfile (Pre-built Binaries)
# =========================================================
FROM debian:bookworm-slim

RUN apt-get update && apt-get install -y --no-install-recommends \
    ca-certificates \
    tzdata \
    && rm -rf /var/lib/apt/lists/*

RUN useradd -m -u 1001 -U appuser
USER appuser
WORKDIR /app

ARG TARGETARCH
ARG TARGETVARIANT
COPY bin/${TARGETARCH}${TARGETVARIANT}/botgek /app/botgek

CMD ["/app/botgek"]
