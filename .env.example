# ==========================================
# BOTGEK - Modern Discord Link Dönüştürücü
# ==========================================

# Discord Bot Token (Discord Developer Portal'dan alınır)
# ZORUNLU: Developer Portal -> Bot sayfasından "MESSAGE CONTENT INTENT" açık olmalıdır!
DISCORD_TOKEN=your_bot_token_here

# Platform Yönlendirme Alan Adları (**yalnızca** proxy motoru kullanılabilen platformlar için)
# Not: Twitter/X, Instagram ve Reddit **yalnızca native embed** ile çalışır (proxy modu ve proxy
# yedeği bu platformlarda kaldırıldı), bu yüzden alan adı ayarı yoktur. WebUI > "Link Dönüştürme
# Motoru" panelinden kalan platformlar için alan adı girebilirsiniz; oradaki değer doluysa
# buradaki (.env) değeri geçersiz kılar. Aynı panelden platformlar için proxy yerine
# "Native Embed" (bot gönderiyi kendi çözer) motoru ve Türkçe/İngilizce dışındaki X gönderileri
# için "Otomatik Türkçe çeviri" (X'in kendi çevirisi) seçilebilir.
TIKTOK_DOMAIN=tnktok.com
BLUESKY_DOMAIN=fxbsky.app
# Spotify: native motor (botun kendi Components V2 kartı) preview'i kendisi çeker;
# Discord V2 mesajlarında 30 sn ses satır içi oynatılamadığı için kart, Spotify + Apple Music
# + YouTube Music butonları sunar. Proxy modunda open.spotify.com bu alan adına yönlendirilir.
SPOTIFY_DOMAIN=open.fixspotify.com

# Tumblr NPF/reblog/multi-media renderer (fxtumblr-compatible public instance).
# Boş bırakılırsa doğrudan Tumblr public OG metadata fallback'i kullanılır.
FXTUMBLR_DOMAIN=tpmblr.com

# Orijinal kullanıcı mesajı silinsin mi? (true / false)
# Botun bu işlem için sunucuda "Mesajları Yönet" (MANAGE_MESSAGES) yetkisine sahip olması gerekir.
DELETE_ORIGINAL=true

# WebUI Kontrol Paneli Portu (Varsayılan: 3000 -> http://localhost:3000)
WEB_PORT=3000
# Yönetim tokenı: en az 32 karakterlik rastgele bir sır girin; boşsa WebUI açılmaz.
# Tokenı Git'e veya loglara yazmayın. Örnek güvenli üretim: openssl rand -hex 32
ADMIN_TOKEN=
WEB_BIND=127.0.0.1
# HTTPS ters proxy kullanırken true yapın. Uzak erişimde HTTPS zorunludur.
WEB_SECURE_COOKIE=false

# OpenRouter API Anahtarı (Bot etiketlendiğinde veya yanıtlandığında AI sohbet için)
# https://openrouter.ai/keys adresinden ücretsiz alabilirsiniz
OPENROUTER_API_KEY=your_openrouter_api_key_here

# Log Detay Seviyesi
RUST_LOG=botgek=info,serenity=warn

# Docker Compose kalıcı volume adı. Yalnızca daha önce farklı isimle oluşturulmuş
# bir volume'u kullanacaksanız değiştirin; varsayılan: botgek_botgek-data
# BOTGEK_DATA_VOLUME=botgek_botgek-data

# Kalıcı kayıt veritabanı (SQLite) yolu.
# Boş bırakılırsa çalışma dizinindeki botgek.db kullanılır
# (systemd: /var/lib/botgek/botgek.db, Docker: BOTGEK_DB_PATH=/app/data/botgek.db).
# Bu dosya botun dönüştürdüğü kartların kayıtlarını tutar (🗑️ silme izni + AI koruması);
# silinirse bot çalışmaya devam eder ama geçmiş kart kayıtlarını unutur.
BOTGEK_DB_PATH=botgek.db

# Reddit OAuth istemci kimliği (isteğe bağlı).
# Reddit, kimliksiz `.json` isteklerini 403 (JS meydan okuması) ile engellediği için bot,
# kullanıcı izni gerektirmeyen **installed_client** OAuth akışıyla bearer token alıp
# `oauth.reddit.com` üzerinden okur. Gömülü varsayılan, herkese açık bir istemci kimliğidir
# (redlib ile aynı yöntem) ve normalde değiştirmenize gerek yoktur. Kendi Reddit
# uygulamanızın (script/installed app) kimliğini kullanmak isterseniz buraya yazın.
# Sır değildir (kimlik public'tir; parola/secret gerekmez).
REDDIT_CLIENT_ID=

# Instagram oturum çerezi (isteğe bağlı ama reellerin KART İÇİNDE OYNAMASI için gerekli).
# Instagram, reel/video mp4'ünü (ve carousel görsellerinin tamamını) girişsiz istemcilere
# vermiyor: çerezsiz API çağrısı giriş sayfasına yönlendiriyor, embed sayfasının
# `contextJSON` alanı `null` dönüyor. Bu değer girilirse bot, gönderiyi Instagram'ın
# uygulama API'sinden (`/api/v1/media/{pk}/info/`) çeker ve videoyu doğrudan karta koyar.
#
# Çerez, tarayıcıda instagram.com oturumu açıp geliştirici araçlarından (Application →
# Cookies → https://www.instagram.com → `sessionid`) alınır. GİZLİDİR: settings.json'a ve
# WebUI'a yazılmaz, yalnızca bu dosyadan okunur. Çerez süresi dolarsa (bot logunda
# "oturum isteği reddedildi") yeni değeri yazın; boş bırakılırsa davranış değişmez
# (kart, reelin kapak karesini + "Reel" etiketini gösterir).
INSTAGRAM_SESSIONID=


