#!/bin/sh
# @file postinst
# @brief botgek paketinin kurulum sonrası betiği.
# @description
#   `botgek` sistem kullanıcısını/grubunu ve `/var/lib/botgek` dizinini hazırlar, ortam dosyasını şablondan bir kez üretir ve systemd'yi yeniler.
#   Birim dosyası `User=botgek` ister; kullanıcı yoksa servis `217/USER` ile düşer.
#   Debian maintainer betikleri `/bin/sh` (dash) ile çalışır; `pipefail` bilinçli olarak kullanılmaz.
set -eu

STATE_DIR=/var/lib/botgek
ENV_FILE=/etc/botgek/botgek.env

# @description `botgek` sistem grubunu ve kullanıcısını yoksa oluşturur.
# @noargs
ensure_account() {
    if ! getent group botgek >/dev/null; then
        groupadd --system botgek
    fi
    if ! getent passwd botgek >/dev/null; then
        useradd --system --gid botgek --home-dir "$STATE_DIR" --no-create-home --shell /usr/sbin/nologin botgek
    fi
}

# @description Kalıcı veri dizinini oluşturur; servis de `StateDirectory=` ile aynısını yapar.
# @noargs
ensure_state_dir() {
    install -d -m 0750 -o botgek -g botgek "$STATE_DIR"
}

# @description Ortam dosyası yoksa şablondan `root:root 0600` olarak üretir; mevcut dosyaya dokunmaz.
# @noargs
ensure_env_file() {
    if [ ! -e "$ENV_FILE" ] && [ -f "$ENV_FILE.example" ]; then
        install -m 0600 -o root -g root "$ENV_FILE.example" "$ENV_FILE"
        echo "botgek: $ENV_FILE oluşturuldu; DISCORD_TOKEN değerini girip 'systemctl enable --now botgek' çalıştırın."
    fi
}

# @description systemd çalışıyorsa birimleri yeniden yükler ve çalışan servisi yeni ikiliyle yeniden başlatır.
# @noargs
reload_service() {
    if [ -d /run/systemd/system ]; then
        systemctl daemon-reload || true
        systemctl try-restart botgek.service || true
    fi
}

case "${1:-}" in
    configure)
        ensure_account
        ensure_state_dir
        ensure_env_file
        reload_service
        ;;
esac

exit 0
