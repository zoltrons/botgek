#!/bin/sh
# @file postrm
# @brief botgek paketinin kaldırma sonrası betiği.
# @description
#   Birim dosyası silindikten sonra systemd'yi yeniler.
#   Kullanıcı, `/var/lib/botgek` (veritabanı + ayarlar) ve `/etc/botgek/botgek.env` bilinçli olarak silinmez: `purge` sonrası da veri kaybı olmasın.
#   Debian maintainer betikleri `/bin/sh` (dash) ile çalışır; `pipefail` bilinçli olarak kullanılmaz.
set -eu

case "${1:-}" in
    remove | purge)
        if [ -d /run/systemd/system ]; then
            systemctl daemon-reload || true
        fi
        ;;
esac

exit 0
